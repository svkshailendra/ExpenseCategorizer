@using ExpenseCategorizer.Pages
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using BlazorApplicationInsights
@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Navigation
@inject SignOutSessionStateManager SignOutManager
@inject ApplicationInsights AppInsights


<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <AuthorizeView>
                <Authorized>
                    Hello, @(context.User?.Identity?.Name ?? "User")!
                    <button class="btn btn-link" @onclick="Logout">Logout</button>
                </Authorized>
                <NotAuthorized>
                    <a href="authentication/login">Login</a>
                </NotAuthorized>
            </AuthorizeView>

            <nav class="nav">
                <a class="nav-link" href="/about">About</a>
                <a class="nav-link" href="/privacy">Privacy</a>
                <a class="nav-link" href="/samples">Samples</a>
            </nav>
        </div>
        <ConsentBanner />
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code {
    protected override void OnInitialized()
    {
        // 1. Listen for internal page changes
        Navigation.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                if (AppInsights != null)
                {
                    await AppInsights.TrackPageView();
                }
            }
            catch (Exception ex)
            {
                Console.Error.WriteLine($"AppInsights initialization failed: {ex.Message}");
            }             
        }
    }

    private async void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        // Log a hit every time the URL changes
        if (AppInsights != null)
        {
            await AppInsights.TrackPageView();
        }
        StateHasChanged();
    }

    private async Task Logout()
    {
        await SignOutManager.SetSignOutState();
        // Navigate through Blazor/MSAL pipeline so logout is recognized as "in-page"
        Navigation.NavigateTo("authentication/logout");
    }

    //  Clean up the event listener when the layout is destroyed
    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }
}