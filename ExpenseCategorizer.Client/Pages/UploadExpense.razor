@page "/upload"
@inject ExpenseService ExpenseService

<AuthorizeView>
    <Authorized>
        <h3>Upload Expense</h3>

        <InputFile OnChange="HandleFileSelected" />

        <button @onclick="UploadFile">Upload</button>

        @if (uploadStatus != null)
        {
            <p>@uploadStatus</p>
        }

        <!-- Info card for JSON format -->
        <div class="card mt-3">
            <div class="card-header">
                Supported Upload Formats
            </div>
            <div class="card-body">
                <h6>1. JSON (direct upload)</h6>
                <pre>
                    {
                    "description": "Lunch with client",
                    "category": "Food",
                    "explanation": "Client meeting meal",
                    "date": "2026-03-05",
                    "amount": 55.5
                    }
                </pre>
                <p class="text-muted">
                    Developers can upload structured JSON directly in this format.
                </p>

                <h6>2. Other formats (OCR/ML pipeline)</h6>
                <p>
                    You can also upload receipts, PDFs, or images.
                    These will be processed automatically using OCR and machine learning,
                    then converted into the same JSON structure shown above.
                    If changes are needed, you can edit them in the GetExpenses page or delete them accordingly.
                </p>

                <h5>Need sample files?</h5>
                <p class="text-muted">
                    Want to see how it works before uploading your own?
                    Visit the <a href="/samples">Samples page</a> to download example receipts, JSON, and invoices.
                </p>
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <p class="text-muted">Please login to upload expenses.</p>
    </NotAuthorized>
</AuthorizeView>

@code {
    private IBrowserFile selectedFile;
    private string uploadStatus;

    private void HandleFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
    }

    private async Task UploadFile()
    {
        if (selectedFile != null)
        {
            uploadStatus = "Uploading...";
            var result = await ExpenseService.UploadExpense(selectedFile);
            uploadStatus = result ? "Upload successful!" : "Upload failed.";
        }
    }
}
