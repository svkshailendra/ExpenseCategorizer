@page "/dashboard"
@using ExpenseCategorizer.Shared
@inject ExpenseService ExpenseService

<Toast Message="@toastMessage" />

<h3>Expense Dashboard</h3>

@if (expenses == null)
{
    <p>Loading...</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Description</th>
                <th>Category</th>
                <th>Explanation</th>
                <th>Date</th>
                <th>Amount</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var expense in expenses)
            {
                <tr>
                    <td>@expense.Description</td>
                    <td>@expense.Category</td>
                    <td>@expense.Explanation</td>
                    <td>@expense.Date.ToString("dd-MMM-yyyy")</td>
                    <td>@expense.Amount</td>
                    <td>
                        <button class="btn btn-sm btn-primary" @onclick="() => StartEdit(expense)">Edit</button>
                        <button class="btn btn-sm btn-danger" @onclick="() => DeleteExpense(expense.Id, expense.Category)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (editingExpense != null)
{
    <div class="modal show d-block" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content p-3">
                <h5>Edit Expense</h5>
                <div class="mb-2">
                    <label>Description</label>
                    <InputText class="form-control" @bind-Value="editingExpense.Description" />
                </div>
                <div class="mb-2">
                    <label>Category (read only)</label>
                    <input class="form-control" value="@editingExpense.Category" readonly />
                </div>
                <div class="mb-2">
                    <label>Explanation</label>
                    <InputText class="form-control" @bind-Value="editingExpense.Explanation" />
                </div>
                <div class="mb-2">
                    <label>Amount</label>
                    <InputNumber class="form-control" @bind-Value="editingExpense.Amount" />
                </div>
                <div class="mb-2">
                    <label>Date</label>
                    <InputDate class="form-control" @bind-Value="editingExpense.Date" />
                </div>
                <button class="btn btn-success" @onclick="SaveEdit">Save</button>
                <button class="btn btn-secondary" @onclick="CancelEdit">Cancel</button>
            </div>
        </div>
    </div>
}

@if (isLoading)
{
    <div class="spinner-border text-primary position-fixed bottom-0 end-0 m-3" role="status">
        <span class="visually-hidden">Loading...</span>
    </div>
}

@code {
    private List<Expense> expenses;
    private Expense editingExpense;
    private string toastMessage;
    private bool isLoading = false;

    protected override async Task OnInitializedAsync()
    {
        expenses = await ExpenseService.GetExpensesAsync();
    }

    private void StartEdit(Expense expense)
    {
        // Create a copy so edits don’t immediately affect the table until saved
        editingExpense = new Expense
        {
            Id = expense.Id,
            Description = expense.Description,
            Category = expense.Category,
            Explanation = expense.Explanation,
            Date = expense.Date,
            Amount = expense.Amount
        };
    }

    private async Task SaveEdit()
    {
        isLoading = true;
        StateHasChanged();

        await ExpenseService.UpdateExpenseAsync(editingExpense);
        expenses = await ExpenseService.GetExpensesAsync(); // refresh
        editingExpense = null;

        isLoading = false;
        // Show toast
        ShowToast("Expense updated successfully!");
        StateHasChanged(); 
    }

    private void CancelEdit() => editingExpense = null;

    private async Task DeleteExpense(string id, string category)
    {
        isLoading = true;
        StateHasChanged();

        await ExpenseService.DeleteExpenseAsync(id, category);
        expenses = await ExpenseService.GetExpensesAsync(); // refresh

        isLoading = false;
        // Show toast
        ShowToast("Expense deleted successfully!");        
    }
    private async void ShowToast(string message)
    {
        toastMessage = message;
        StateHasChanged();
        await Task.Delay(3000);
        toastMessage = string.Empty;
        StateHasChanged();
    }
}
